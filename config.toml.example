# Copy to user/project config.toml; paths and precedence: CONFIG.md.
# Credentials belong in .env. This example selects offline mode.
llm_model = "offline:none" # Built-in default: "openai:gpt-4o-mini".
user_id = "default"
github_repos = [] # owner/repo entries enable TUI read-only pulls.
github_sync_interval_seconds = 3600 # Minimum: 30; no automatic push.
memory_enabled = false

# For local chat, replace llm_model above and add api_endpoint (unset by default).
# llm_model = "local:your-model-alias"
# api_endpoint = "http://127.0.0.1:8080/v1"
# Optional local authentication: TASKWEAVER_API_KEY in .env.

# Unset by default; relative paths resolve from this file's directory.
# database_file = "tasks.db"

# For memory, install taskweaver[memory], enable memory_enabled, and configure both services.
mem0_llm_provider = "openai"
mem0_embedding_provider = "openai"
mem0_embedding = "text-embedding-3-small"
mem0_max_memories = 10 # Range: 1–100.

# Unset by default; model falls back to llm_model.
# mem0_llm_model = "openai:gpt-4o-mini"
# mem0_site_url = "https://api.openai.com/v1"
# mem0_embedding_endpoint = "https://api.openai.com/v1"
