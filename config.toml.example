# Flat preferences. Copy to your native TaskWeaver config directory or
# an existing project's config.toml. See CONFIG.md for precedence and paths.
# No credentials belong in TOML.
llm_model = "offline:none"
user_id = "default"
github_repos = []
# When repositories are configured, TUI imports/pulls read-only on startup and
# periodically. No automatic push; interval must be at least 30 seconds.
github_sync_interval_seconds = 3600
memory_enabled = false

# Anonymous OpenAI-compatible local chat (model must exist on your service):
# llm_model = "local:your-model-alias"
# api_endpoint = "http://127.0.0.1:8080/v1"
# Optional TASKWEAVER_API_KEY belongs in .env, not here.

# Relative database paths are anchored to this config file's directory.
# database_file = "tasks.db"

# Optional semantic memory requires the memory extra and real LLM/embedding services.
# Enable deliberately; chat endpoints need not support embeddings.
# memory_enabled = true
# mem0_llm_provider = "openai"
# mem0_llm_model = "openai:gpt-4o-mini"
# mem0_site_url = "https://api.openai.com/v1"
# mem0_embedding_provider = "openai"
# mem0_embedding = "text-embedding-3-small"
# mem0_embedding_endpoint = "https://api.openai.com/v1"
# mem0_max_memories = 10
