# Copy to user/project .env; uncomment only the entries you need.
# Process environment wins; values are not interpolated.
# Never commit secrets. Use chmod 600 on POSIX or restrictive Windows ACLs.

# Main model and memory provider credentials:
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Local services: unset/empty means anonymous, without cloud key fallback.
# TASKWEAVER_API_KEY=

# GitHub: GH_TOKEN wins; authorized status writes require explicit --push.
# GH_TOKEN=
# GITHUB_TOKEN=

# Langfuse: taskweaver[observability] and chat/tui --o are required.
# Traces may export prompts, responses, and tool data.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Mem0 SDK state: defaults to native data/taskweaver/mem0.
# MEM0_DIR=/private/path/to/mem0-state
# Optional SDK telemetry; TaskWeaver defaults it to False unless already set.
# MEM0_TELEMETRY=False

# Set XDG_CONFIG_HOME/XDG_DATA_HOME/XDG_CACHE_HOME/XDG_STATE_HOME
# in the process environment before launch, not here (see CONFIG.md).
# Windows roots otherwise use APPDATA (config) and LOCALAPPDATA.
