# Copy to TaskWeaver's native config directory or detected project .env.
# All entries are commented: uncomment only real credentials you need.
# Process environment wins over files; values are not interpolated.
# Keep this file private (POSIX chmod 600; restrictive Windows directory ACL).
# Never commit credentials. Offline/local task workflows need none.

# Main model provider (see config.toml.example and CONFIG.md):
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Optional authentication for local OpenAI-compatible services.
# Empty/unset means anonymous local chat, with no cloud credential fallback.
# TASKWEAVER_API_KEY=

# GitHub public reads can be anonymous; explicit --push requires authorization.
# GH_TOKEN takes precedence over GITHUB_TOKEN.
# GITHUB_TOKEN=
# GH_TOKEN=

# Optional observability: requires observability extra AND chat/tui --o.
# Tracing may export prompt/response/tool content; review retention policy.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Optional Mem0 SDK state location (normally application data).
# MEM0_DIR=/private/path/to/mem0-state
