Screen { background: $background; }
Header { height: 1; }
Footer { height: 1; }
#views { height: 1fr; }
TabbedContent > ContentSwitcher { height: 1fr; }
TabPane { padding: 0 1; }
.legend { height: auto; color: $text-muted; }
DataTable { height: 1fr; }
#board { height: 1fr; }
.board-column { width: 1fr; border-right: solid $primary; padding: 0 1; }
.board-column DataTable { height: 1fr; }
#dependency-graph { height: auto; padding: 1 0; }
#graph-tasks { height: 1fr; min-height: 5; }
#notice { height: 2; color: $text-muted; padding: 0 1; }
#chat-view { height: 1fr; }
#input-field { height: 4; border: solid $accent; }
Markdown { padding: 0 1; }
.user-message, .agent-message, .system-message { margin: 0 0 1 0; }
.error-message { border-left: solid $error; color: $error; }
FormScreen, TaskFormScreen, CompletionScreen, DependencyScreen, PlanningFormScreen, TaskDetailScreen {
    align: center middle;
    background: $background 70%;
}
.dialog { width: 74; max-width: 96%; height: 90%; background: $surface; border: solid $primary; padding: 0 1; }
.form-fields { height: 1fr; }
.form-fields Label { height: auto; margin-top: 1; }
.form-fields Input, .form-fields Select { height: 3; }
#form-error { height: auto; max-height: 4; color: $error; }
.dialog-buttons { height: 3; }
.dialog-buttons Button { margin-right: 1; }
#close-button { height: 3; }
